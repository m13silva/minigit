import "go:fmt"
import "go:github.com/spf13/cobra"
import "go:os"

import "store"

fn init_cmd() -> Ref<cobra.Command> {
  let mut cmd = cobra.Command {
    Use: "init",
    Short: "",
    RunE: Some(|_: Ref<cobra.Command>, _: Slice<string>| -> Result<(), error> {
      let dir = ".minigit" + "/objects/"
      if os.Stat(dir).is_err() { os.MkdirAll(dir, 0o755)? }
      Ok(())
    }),
    ..,
  }
  &cmd
}

fn add_cmd(st: mut Ref<store.Store>) -> Ref<cobra.Command> {
  let mut cmd = cobra.Command {
    Use: "add",
    Short: "",
    Args: Some(cobra.ExactArgs(1)),
    RunE: Some(
      |_: Ref<cobra.Command>, args: Slice<string>| -> Result<(), error> {
        st.add(".minigit", args[0])?
        Ok(())
      },
    ),
    ..,
  }
  &cmd
}

fn log_cmd() -> Ref<cobra.Command> {
  let mut cmd = cobra.Command {
    Use: "log",
    Short: "",
    RunE: Some(|_: Ref<cobra.Command>, _: Slice<string>| -> Result<(), error> {
      store.log(".minigit")?
      Ok(())
    }),
    ..,
  }
  &cmd
}

fn commit_cmd(st: mut Ref<store.Store>) -> Ref<cobra.Command> {
  let mut message = ""
  let mut cmd = cobra.Command {
    Use: "commit",
    Short: "",
    RunE: Some(|_: Ref<cobra.Command>, _: Slice<string>| -> Result<(), error> {
      let _ = st.commit(".minigit", message)?
      Ok(())
    }),
    ..,
  }

  cmd.Flags().StringVarP(&message, "message", "m", "", "mensaje del commit")
  &cmd
}

fn catfile_cmd() -> Ref<cobra.Command> {
  let mut hash = ""
  let mut cmd = cobra.Command {
    Use: "cat-file",
    Short: "",
    RunE: Some(|_: Ref<cobra.Command>, _: Slice<string>| -> Result<(), error> {
      let out = store.read_object(".minigit", hash)?
      if !out.is_empty() { fmt.Println(out as string) }
      Ok(())
    }),
    ..,
  }

  cmd.Flags().StringVarP(&hash, "p", "p", "", "hash del commit")
  &cmd
}

fn branch_cmd(st: mut Ref<store.Store>) -> Ref<cobra.Command> {
  let mut create = false
  let mut cmd = cobra.Command {
    Use: "branch",
    Short: "",
    Args: Some(cobra.ExactArgs(1)),
    RunE: Some(
      |_: Ref<cobra.Command>, args: Slice<string>| -> Result<(), error> {
        if create { st.create_branch(".minigit", args[0])? }
        Ok(())
      },
    ),
    ..,
  }

  cmd.Flags().BoolVarP(&create, "create", "c", false, "crear un branch")
  &cmd
}

fn checkout_cmd() -> Ref<cobra.Command> {
  let mut cmd = cobra.Command {
    Use: "checkout",
    Short: "",
    Args: Some(cobra.ExactArgs(1)),
    RunE: Some(
      |_: Ref<cobra.Command>, args: Slice<string>| -> Result<(), error> {
        store.checkout(".minigit", args[0])?
        Ok(())
      },
    ),
    ..,
  }
  &cmd
}

pub fn root_command(st: mut Ref<store.Store>) -> mut cobra.Command {
  let mut root = cobra.Command { Use: "minigit", .. }
  root.AddCommand(
    init_cmd(),
    add_cmd(st),
    commit_cmd(st),
    log_cmd(),
    catfile_cmd(),
    checkout_cmd(),
    branch_cmd(st),
  )
  root
}
