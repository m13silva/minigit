import "go:bytes"
import "go:compress/zlib"
import "go:errors"
import "go:fmt"
import "go:io"
import "go:os"
import "go:path/filepath"
import "go:sort"
import "go:strings"

import "objects"
import "utils"

pub struct Store {
  pub index: mut Map<string, string>,
}

impl Store {
  pub fn new() -> mut Store {
    Store { index: Map.new<string, string>() }
  }

  pub fn add_index(self: mut Ref<Store>, path: string, hex: string) {
    self.index[path] = hex
  }

  pub fn load_index(self: mut Ref<Store>, minigit_dir: string) {
    let index = minigit_dir + "/index"
    if let Ok(lines) = os.ReadFile(index) {
      let _lines = bytes.Split(lines, ['\n'])
      for line in _lines {
        let sp = bytes.Split(line, [' '])
        if sp.length() == 2 {
          let hex = sp[0] as string
          let path = sp[1] as string
          self.index[path] = hex
        }
      }
    }
  }

  pub fn write_index(self: Ref<Store>, minigit_dir: string) -> Result<(), error> {
    let index = minigit_dir + "/index"
    let mut data = strings.Builder { .. }
    for (path, hex) in self.index {
      data.WriteString(f"{hex} {path}\n")
    }
    os.WriteFile(index, data.String().bytes(), 0o644)?
    Ok(())
  }

  pub fn write_tree(
    self: mut Ref<Store>,
    minigit_dir: string,
  ) -> Result<string, error> {
    let mut paths = Slice.new<string>()
    self.load_index(".minigit")
    for (p, _) in self.index {
      paths = paths.append(p)
    }
    sort.Strings(paths)
    let mut builder = strings.Builder { .. }
    for path in paths {
      let hex = self.index[path]
      builder.WriteString(f"blob {hex} {path}\n")
    }
    let tree_content = builder.String().bytes()
    let (hex, compressed) = objects.hash_object("tree", tree_content)?
    write_object(minigit_dir, hex, compressed)?
    Ok(hex)
  }

  pub fn commit(
    self: mut Ref<Store>,
    minigit_dir: string,
    message: string,
  ) -> Result<string, error> {
    let tree_hash = self.write_tree(minigit_dir)?
    let (parent_hash, isref) = read_head(minigit_dir, "HEAD")
    let (_parent_hash, head) = if isref {
      let (ref_parent_hash, _) = read_head(minigit_dir, parent_hash)
      (ref_parent_hash, minigit_dir + "/" + parent_hash)
    } else {
      (parent_hash, minigit_dir + "/HEAD")
    }

    let p_hash = if _parent_hash.is_empty() {
      ""
    } else {
      f"parent {_parent_hash}\n"
    }
    let content = (f"tree {tree_hash}\n" + p_hash + f"message {message}\n").bytes()
    let (hex, compressed) = objects.hash_object("commit", content)?
    write_object(minigit_dir, hex, compressed)?
    os.WriteFile(head, hex.bytes(), 0o644)?
    Ok("")
  }

  pub fn add(
    self: mut Ref<Store>,
    minigit_dir: string,
    path: string,
  ) -> Result<(), error> {
    let content = os.ReadFile(path)?
    let (hex, compressed) = objects.hash_object("blob", content)?
    write_object(minigit_dir, hex, compressed)?
    self.add_index(path, hex)
    self.write_index(minigit_dir)?
    Ok(())
  }

  pub fn create_branch(
    self: mut Ref<Store>,
    minigit_dir: string,
    branch: string,
  ) -> Result<(), error> {
    let (current, isref) = read_head(minigit_dir, "HEAD")
    let _current = if isref {
      let (ref_current, _) = read_head(minigit_dir, current)
      ref_current
    } else {
      current
    }
    write_ref(minigit_dir, branch, _current)?
    let content = f"ref: refs/heads/{branch}"
    os.WriteFile(minigit_dir + "/HEAD", content.bytes(), 0o644)?
    Ok(())
  }
}

pub fn write_object(
  minigit_dir: string,
  hex: string,
  compressed: Slice<byte>,
) -> Result<(), error> {
  let dir = minigit_dir + "/objects/" + hex.substring(..2)
  let path = dir + "/" + hex.substring(2..)
  if os.Stat(path).is_err() {
    os.MkdirAll(dir, 0o755)?
    os.WriteFile(path, compressed, 0o644)?
  }
  Ok(())
}

pub fn write_ref(
  minigit_dir: string,
  ref: string,
  content: string,
) -> Result<(), error> {
  let dir = minigit_dir + "/refs/heads/"
  let path = dir + ref
  if os.Stat(path).is_err() {
    os.MkdirAll(dir, 0o755)?
    os.WriteFile(path, content.bytes(), 0o644)?
  }
  Ok(())
}

pub fn parse_commit(
  content: Slice<byte>,
) -> Result<(string, string, string), error> {
  let content_str = content as string
  let lines = strings.Split(content_str, "\n")
  let mut tree_hash = ""
  let mut parent_hash = ""
  let mut message = ""

  for line in lines {
    if strings.HasPrefix(line, "tree ") {
      tree_hash = line.substring(5..)
    } else if strings.HasPrefix(line, "parent ") {
      parent_hash = line.substring(7..)
    } else if strings.HasPrefix(line, "message ") {
      message = line.substring(8..)
    }
  }
  if tree_hash.is_empty() { return Err(errors.New("invalid hash")) }
  Ok((tree_hash, parent_hash, message))
}

pub fn read_head(minigit_dir: string, path: string) -> (string, bool) {
  let mut parent_hash = ""
  let mut isref = false
  if let Ok(lines) = os.ReadFile(minigit_dir + "/" + path) {
    parent_hash = lines as string
    if parent_hash.starts_with("ref: ") {
      if let Some(cut) = strings.CutPrefix(parent_hash, "ref: ") {
        parent_hash = cut
        isref = true
      }
    }
  }
  (parent_hash, isref)
}

pub fn log(minigit_dir: string) -> Result<(), error> {
  let (current, isref) = read_head(minigit_dir, "HEAD")
  let mut head = ""
  let mut _current = if isref {
    let (ref_current, _) = read_head(minigit_dir, current)
    if let Some(cut) = strings.CutPrefix(current, "refs/heads/") { head = cut }
    ref_current
  } else {
    current
  }
  if !head.is_empty() { fmt.Println(f"HEAD -> {head}") }
  let branchs = get_branchs(minigit_dir)
  while !_current.is_empty() {
    let content = read_object(minigit_dir, _current)?
    let (_, parent, message) = parse_commit(content)?

    if let Some(branch) = branchs.get(_current) {
      fmt.Println(f"○ {_current} ({branch})")
    } else {
      fmt.Println(f"○ {_current}")
    }
    fmt.Println(f"│  {message}")

    _current = parent
  }
  Ok(())
}

pub fn read_object(
  minigit_dir: string,
  hex: string,
) -> Result<Slice<byte>, error> {
  let path = minigit_dir + "/objects/" + hex.substring(..2) + "/" +
  hex.substring(2..)
  if let Ok(_bytes) = os.ReadFile(path) {
    let mut re = bytes.NewReader(_bytes)
    if let Ok(r) = zlib.NewReader(re) {
      defer r.Close()
      let b = utils.partial_to_result(io.ReadAll(r))?
      let idx = bytes.Index(b, [0])
      if let Some(_idx) = idx { return Ok(b[_idx + 1..]) }
    }
  }

  Ok([])
}

pub fn checkout(minigit_dir: string, target: string) -> Result<(), error> {
  let branch_path = minigit_dir + "/refs/heads/" + target
  let mut commit_hash = ""

  if let Ok(hash_bytes) = os.ReadFile(branch_path) {
    commit_hash = hash_bytes as string
    os.WriteFile(
      minigit_dir + "/HEAD",
      ("ref: refs/heads/" + target).bytes(),
      0o644,
    )?
  } else {
    commit_hash = target
  }

  let commit_content = read_object(minigit_dir, commit_hash)?
  let (tree_hash, _parent, _msg) = parse_commit(commit_content)?
  let tree_content = read_object(minigit_dir, tree_hash)?
  let tree_str = tree_content as string
  let lines = strings.Split(tree_str, "\n")
  for line in lines {
    if line.is_empty() { continue }
    let parts = strings.Split(line, " ")
    let blob_content = read_object(minigit_dir, parts[1])?
    os.WriteFile(parts[2], blob_content, 0o644)?
  }
  Ok(())
}

pub fn get_branchs(minigit_dir: string) -> Map<string, string> {
  let mut map = Map.new<string, string>()
  let dir = minigit_dir + "/refs/heads"
  if os.Stat(dir).is_ok() {
    let mut paths = Slice.new<string>()
    let _ = filepath.Walk(dir, |path, info, err| {
      if !info.IsDir() {
        paths = paths.append(path)
        return Ok(())
      }
      Err(err)
    })

    for path in paths {
      if let Ok(lines) = os.ReadFile(path) {
        let hash = lines as string
        let branch = filepath.Base(path)
        map[hash] = branch
      }
    }
  }

  map
}
